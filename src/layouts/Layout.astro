---
import '../styles/awmedia.css';
import ThreeSpaceCanvas from '../components/ThreeSpaceCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Varizky Naldiba Rimra — Applied Machine Learning & IoT Systems Engineer",
  description = "Informatics Engineer from Politeknik Negeri Malang (Polinema). Specializing in applied machine learning, computer vision, IoT telemetry firmware, and geospatial analytics."
} = Astro.props;
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Varizky Naldiba Rimra" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://myprofile-nine-sigma.vercel.app/" />
    <meta property="og:image" content="/assets/image/saya.jpg" />

    <!-- Typography: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="skip-to-content">Lewati ke konten utama</a>

    <!-- 1. Authentic Three.js 3D WebGL Virtual Camera Space (Puture SpaceScene) -->
    <ThreeSpaceCanvas />

    <!-- 2. Puture Magnetic Interactive Cursor with Follower Label -->
    <div class="puture-cursor-dot" id="puture-cursor-dot" aria-hidden="true"></div>
    <div class="puture-cursor-label" id="puture-cursor-label" aria-hidden="true">
      <span id="cursor-label-text">EXPLORE</span>
    </div>

    <!-- 3. Ambient Dynamic Cursor Spotlight -->
    <div class="cursor-glow-spotlight" id="cursor-glow-spotlight" aria-hidden="true"></div>

    <!-- Main Site Flow -->
    <div class="site-content">
      <slot />
    </div>

    <!-- Puture Clean Dynamic Section HUD Tracker (No Numbers) -->
    <div class="puture-hud" id="puture-chapter-hud" aria-hidden="true">
      <span class="puture-hud-dot" aria-hidden="true"></span>
      <span class="puture-hud-name" id="hud-chapter-name">ABOUT</span>
    </div>

    <script>
      import Lenis from 'lenis';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Lenis Smooth Momentum Scroll Engine
      if (!prefersReducedMotion) {
        try {
          const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            touchMultiplier: 1.5
          });

          function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);

          // Smooth scrolling for anchor links (#projects, #skills, etc.)
          document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
            anchor.addEventListener('click', function (e) {
              const targetId = this.getAttribute('href');
              if (targetId && targetId !== '#') {
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  e.preventDefault();
                  lenis.scrollTo(targetElement, { offset: -70 });
                }
              }
            });
          });
        } catch (e) {
          console.warn('Lenis smooth scroll initialized with fallback.', e);
        }
      }

      // 2. Puture Magnetic Cursor with Dynamic Follower Label
      const cursorDot = document.getElementById('puture-cursor-dot');
      const cursorLabel = document.getElementById('puture-cursor-label');
      const labelText = document.getElementById('cursor-label-text');

      if (cursorDot && cursorLabel && labelText && !prefersReducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let mouseX = -100;
        let mouseY = -100;
        let dotX = -100;
        let dotY = -100;
        let labelX = -100;
        let labelY = -100;
        let isVisible = false;

        window.addEventListener('pointermove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (!isVisible) {
            isVisible = true;
            cursorDot.style.opacity = '1';
          }
        }, { passive: true });

        document.addEventListener('mouseleave', () => {
          isVisible = false;
          cursorDot.style.opacity = '0';
          cursorLabel.style.opacity = '0';
        });

        // Hover listeners for dynamic label change
        const attachCursorListeners = () => {
          document.querySelectorAll('a, button, .stack-card, .curved-card, .dossier-portrait-card').forEach((el) => {
            el.addEventListener('mouseenter', () => {
              let label = el.getAttribute('data-cursor');
              if (!label) {
                if (el.tagName === 'A') {
                  const href = (el as HTMLAnchorElement).href || '';
                  if (href.includes('#contact')) label = 'CONTACT';
                  else if (href.includes('#projects')) label = 'EXPLORE';
                  else if (href.includes('#about')) label = 'DOSSIER';
                  else if (href.includes('.pdf')) label = 'CV PDF';
                  else if (href.includes('github')) label = 'GITHUB';
                  else if (href.includes('linkedin')) label = 'LINKEDIN';
                  else label = 'OPEN';
                } else if (el.classList.contains('stack-card')) {
                  label = 'CAPABILITY';
                } else if (el.classList.contains('curved-card')) {
                  label = 'VIEW SYSTEM';
                } else {
                  label = 'SELECT';
                }
              }
              labelText.textContent = label;
              cursorLabel.style.opacity = '1';
              cursorDot.classList.add('is-hovering');
            });

            el.addEventListener('mouseleave', () => {
              cursorLabel.style.opacity = '0';
              cursorDot.classList.remove('is-hovering');
            });
          });
        };

        attachCursorListeners();

        const renderCursor = () => {
          dotX += (mouseX - dotX) * 0.35;
          dotY += (mouseY - dotY) * 0.35;
          labelX += (mouseX - labelX) * 0.16;
          labelY += (mouseY - labelY) * 0.16;

          cursorDot.style.transform = `translate3d(${dotX}px, ${dotY}px, 0)`;
          cursorLabel.style.transform = `translate3d(${labelX + 16}px, ${labelY + 16}px, 0)`;

          requestAnimationFrame(renderCursor);
        };
        requestAnimationFrame(renderCursor);
      }

      // 3. Puture Dynamic Tone Shift Observer (Black -> Architectural White for Process)
      const methodologySection = document.getElementById('methodology');
      if (methodologySection) {
        const toneObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              document.body.classList.add('is-light');
            } else {
              document.body.classList.remove('is-light');
            }
          }
        }, {
          threshold: 0.25,
          rootMargin: '-10% 0px -10% 0px'
        });

        toneObserver.observe(methodologySection);
      }

      // 4. Clean Dynamic Section HUD Tracker (No Numbers)
      const chapters = [
        { id: 'home', name: 'ABOUT' },
        { id: 'about', name: 'ABOUT' },
        { id: 'projects', name: 'PROJECTS' },
        { id: 'skills', name: 'CAPABILITIES' },
        { id: 'methodology', name: 'PROCESS' },
        { id: 'creative', name: 'MEDIA' },
        { id: 'contact', name: 'CONTACT' }
      ];

      const hudName = document.getElementById('hud-chapter-name');

      if (hudName) {
        const chapterObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const chId = entry.target.getAttribute('data-chapter') || entry.target.id;
              const found = chapters.find(c => c.id === chId);
              if (found) {
                hudName.textContent = found.name;
              }
            }
          }
        }, {
          rootMargin: '-30% 0px -40% 0px'
        });

        document.querySelectorAll('[data-chapter], section[id]').forEach(el => chapterObserver.observe(el));
      }

      // 5. Reveal on Scroll Observer
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in-view');
              entry.target.classList.add('is-in');
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '0px 0px -20px 0px'
        });

        document.querySelectorAll('[data-in], .reveal-on-scroll, .section-head, .glass-card, .feature-card').forEach((el) => {
          revealObserver.observe(el);
        });
      }
    </script>
  </body>
</html>
