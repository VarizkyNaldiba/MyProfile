---
import { ArrowUpRight, FileText } from 'lucide-react';
---

<header class="nav-wrapper">
  <div class="container">
    <nav class="nav-container" aria-label="Main Navigation">
      
      {/* Brand Monogram */}
      <a href="#home" class="nav-brand">
        <span class="brand-badge">VR</span>
        <span class="brand-text">Varizky</span>
      </a>

      {/* Concise Nav Links */}
      <ul class="nav-links">
        <li><a href="#about" class="nav-link">About</a></li>
        <li><a href="#projects" class="nav-link">Projects</a></li>
        <li><a href="#skills" class="nav-link">Skills</a></li>
        <li><a href="#methodology" class="nav-link">Pipeline</a></li>
        <li><a href="#creative" class="nav-link">Media</a></li>
        <li><a href="#contact" class="nav-link">Contact</a></li>
      </ul>

      {/* Header CTA & Quick Links */}
      <div class="nav-cta-row">
        <a 
          href="/CV - Varizky Naldiba Rimra.pdf" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-glass btn-sm desktop-only"
          title="Download Curriculum Vitae (PDF)"
        >
          <FileText size={13} />
          <span>CV</span>
        </a>

        <a 
          href="/Portofolio - Varizky Naldiba Rimra.pdf" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary btn-sm desktop-only"
          title="Download Portfolio Presentation Deck (PDF)"
        >
          <span>Porto</span>
          <ArrowUpRight size={13} />
        </a>
      </div>

    </nav>
  </div>
</header>
