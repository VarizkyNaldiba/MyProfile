---
import { BookOpen, Trophy, Award, CheckCircle, Cpu, Brain, Database, Utensils, Briefcase, Calendar, Building2, Video } from 'lucide-react';

const pillars = [
  {
    icon: Cpu,
    title: "Edge-to-Cloud Telemetry",
    desc: "Merancang pipa telemetri dari mikrokontroler (ESP32/Arduino) dengan kalibrasi sensor non-linear, failover buffer sirkular pada flash memory, hingga sinkronisasi data real-time."
  },
  {
    icon: Brain,
    title: "Applied Computer Vision & ML",
    desc: "Membangun arsitektur density map regression (MCNN/CSRNet) untuk crowd counting, model sekuensial LSTM untuk oseanografi, serta klasifikasi fitur visual hibrida (GLCM/HOG + SVM)."
  },
  {
    icon: Database,
    title: "Geospatial & Spatial Intelligence",
    desc: "Mengolah dataset spasial kewilayahan ke dalam peta interaktif (WebGIS Leaflet & Folium) dan mengidentifikasi disparitas aksesibilitas infrastruktur pendidikan/bencana."
  },
  {
    icon: Utensils,
    title: "Operational Rigor & Discipline",
    desc: "Latar belakang operasional kuliner komersial menanamkan ketahanan kerja di bawah tekanan tinggi, manajemen alur suplai, dan standar eksekusi ketat tanpa kompromi."
  }
];

const experiences = [
  {
    role: "AI & Full-Stack Developer Intern",
    organization: "PT Naraya Telematika",
    type: "Magang Industri",
    period: "Juli 2026 – Sekarang",
    desc: "Mengembangkan pipeline produksi animasi AI generatif berbasis integrasi workflow ComfyUI dan Dify, serta merancang dan mengimplementasikan platform website Ads Manager yang terintegrasi langsung dengan Meta Ads API dan Google Ads API.",
    skills: ["ComfyUI", "Dify", "Generative AI", "Meta Ads API", "Google Ads API", "Full-Stack Web", "System Integration"],
    icon: Building2
  },
  {
    role: "IT & WebGIS Production Developer",
    organization: "Badan Riset dan Inovasi Nasional (BRIN) × Polinema",
    type: "Magang Riset Terapan",
    period: "Mei – Juli 2026",
    desc: "Mengembangkan platform WebGIS produksi SIMOJANG Brantas untuk peringatan dini banjir DAS Brantas Hulu. Mengintegrasikan telemetri radar BMKG, data spasial BPBD, dan optimasi rendering GeoJSON.",
    skills: ["WebGIS", "Leaflet", "GeoJSON", "Spatial DB", "BMKG Radar"],
    icon: Building2
  },
  {
    role: "Cook",
    organization: "Sektor F&B Komersial (Hospitality & Culinary Operations)",
    type: "Operasional Komersial",
    period: "2025",
    desc: "Mengelola alur operasional dapur komersial berkecepatan tinggi, konsistensi mutu penyajian, manajemen bahan baku, serta penegakan standar kerja presisi dengan toleransi kesalahan nol.",
    skills: ["Operational Rigor", "High-Pace Execution", "Quality Control", "Inventory Flow"],
    icon: Utensils
  },
  {
    role: "Content Creator",
    organization: "Kanal Multimedia Mandiri (@oryzasatirva & Bilibili)",
    type: "Produksi Media Digital",
    period: "2020 – Sekarang",
    desc: "Memproduksi video analisis mekanik sistem digital, panduan teknis komparatif, dan motion graphics. Menganalisis kurva retensi pemirsa serta strategi optimasi algoritma distribusi konten multimedia.",
    skills: ["Motion Graphics", "Video Production", "Retention Analytics", "Digital Media"],
    icon: Video
  }
];

const getExpBadgeClass = (type: string) => {
  const lower = type.toLowerCase();
  if (lower.includes('riset') || lower.includes('magang') || lower.includes('intern')) return 'card-honor-badge honor-finalist';
  if (lower.includes('operasional')) return 'card-honor-badge honor-juara';
  return 'card-honor-badge honor-peserta';
};

const honors = [
  {
    badge: "Juara Harapan 2 LKTI Nasional",
    title: "Techno Fair and Seminar (TFS) 2026 — CatfishCare",
    sk: "SK Direktur Polinema No. 27881/PL2.3/KM/2026",
    desc: "Otomasi aerasi dan sirkulasi kolam budidaya lele berbasis pemantauan parameter kimia air real-time."
  },
  {
    badge: "Lolos Seleksi Tahap 2 Insentif",
    title: "PKM-GFT POLINEMA 2026 — Smart Aquaculture Intelligence System (SAIS)",
    sk: "SK No. 40/WADIR.III/KM/2026",
    desc: "Konsep tata kelola akuakultur presisi berbasis digital twin dan simulasi prediktif multi-kolam."
  },
  {
    badge: "Peringkat 18 / 82 (Skor 94.310)",
    title: "Intelecta Cup 2025 — Agroclimatology Time-Series Weather Forecasting",
    sk: "Leaderboard Kompetisi Nasional",
    desc: "Prediksi curah hujan dan anomali cuaca ekstrem pertanian menggunakan regresi ensemble multi-variat."
  },
  {
    badge: "Finalis Nasional LKTI",
    title: "Techno Fair and Seminar (TFS) 2025 — AlgaSense",
    sk: "SK Direktur Polinema No. 16002/PL2.3/KM/2025",
    desc: "Telemetri oseanografi bawah laut dan peramalan panen rumput laut menggunakan jaringan syaraf LSTM di Sumenep."
  },
  {
    badge: "Peserta Resmi",
    title: "Hology 8.0 (2025) Data Mining — Crowd Density Estimation",
    sk: "Kompetisi Nasional Universitas Brawijaya",
    desc: "Pengembangan regresi estimasi kerumunan manusia skala variabel berbasis Multi-Column CNN (MCNN)."
  },
  {
    badge: "Peserta Resmi",
    title: "Jatim Datathon 2025 — SLB Spatial Disparity Analysis",
    sk: "Kompetisi Sains Data Jawa Timur",
    desc: "Analisis disparitas spasial dan rasio aksesibilitas sekolah luar biasa di seluruh Jawa Timur."
  }
];

const getBadgeClass = (badge: string) => {
  const lower = badge.toLowerCase();
  if (lower.includes('juara')) return 'card-honor-badge honor-juara';
  if (lower.includes('finalis') || lower.includes('finalist')) return 'card-honor-badge honor-finalist';
  if (lower.includes('peserta')) return 'card-honor-badge honor-peserta';
  return 'card-honor-badge honor-general';
};
---

<section class="section-padding" id="about">
  <div class="container">
    
    {/* Section Head */}
    <div class="section-head">
      <div class="kicker">Professional Background</div>
      <h2 class="section-title">Engineering with Purpose & Rigor</h2>
      <p class="section-subtitle">
        Fondasi akademik D4 Teknik Informatika Politeknik Negeri Malang dipadukan dengan disiplin operasional lapangan untuk membangun sistem yang handal.
      </p>
    </div>

    {/* Main Grid: Left Narrative + Right Verified Honors */}
    <div class="about-grid">
      
      {/* Left Column: Narrative & Pillars */}
      <div>
        <div class="glass-card" style="margin-bottom: 2rem;">
          <h3 style="font-size: 1.45rem; font-weight: 800; color: #fff; margin-bottom: 1rem; letter-spacing: -0.02em;">
            Menjembatani Perangkat Keras Fisik, Data Spasial, dan Kecerdasan Buatan Terapan.
          </h3>
          <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1rem;">
            Saya merupakan mahasiswa <strong>D4 Teknik Informatika di Politeknik Negeri Malang (Polinema)</strong>. 
            Prinsip rekayasa saya berakar pada <em>Project-Based Learning</em> dan pemecahan masalah konkret: 
            mengkalibrasi sensor kimia air untuk pembudidaya lele dan rumput laut, memetakan risiko banjir 
            DAS Brantas bersama BRIN, hingga merancang portal akademik terdesentralisasi.
          </p>
          <p style="color: var(--text-secondary); line-height: 1.7;">
            Disiplin operasional di dapur komersial sebelum mendalami informatika membentuk cara kerja saya: 
            selalu siap menangani kondisi kritis, menghargai toleransi kesalahan nol, dan memastikan setiap baris kode 
            berfungsi optimal di lingkungan produksi.
          </p>

          {/* Education Callout */}
          <div class="education-callout">
            <div class="edu-icon-wrap">
              <BookOpen size={22} />
            </div>
            <div>
              <span style="display: block; font-size: 0.95rem; font-weight: 700; color: #fff;">
                D4 Teknik Informatika (Informatics Engineering)
              </span>
              <span style="display: block; font-size: 0.82rem; color: var(--accent-cyan); margin-top: 0.2rem;">
                Politeknik Negeri Malang (Polinema) · 2022 – Sekarang
              </span>
              <span style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem;">
                Fokus: Kecerdasan Buatan Terapan, Telemetri IoT, Sistem Informasi & WebGIS
              </span>
            </div>
          </div>
        </div>

        {/* Work & Intern Experience */}
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <div style="width: 38px; height: 38px; border-radius: 50%; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.4); display: flex; align-items: center; justify-content: center; color: var(--accent-blue);">
              <Briefcase size={18} />
            </div>
            <div>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: #fff;">Pengalaman Kerja & Magang</h3>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Work, Internship & Applied Engineering Roles</span>
            </div>
          </div>

          <div class="experience-list">
            {experiences.map((exp, idx) => {
              const ExpIcon = exp.icon;
              return (
                <div key={idx} class="experience-item">
                  <div class="exp-icon-wrap">
                    <ExpIcon size={16} />
                  </div>
                  <div style="flex: 1; min-width: 0;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
                      <span class={getExpBadgeClass(exp.type)}>
                        {exp.type}
                      </span>
                      <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-cyan); display: inline-flex; align-items: center; gap: 0.35rem;">
                        {exp.period.includes('Sekarang') && (
                          <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 6px #4ade80;" title="Posisi Aktif"></span>
                        )}
                        <Calendar size={12} />
                        {exp.period}
                      </span>
                    </div>
                    <h4 style="font-size: 0.92rem; font-weight: 700; color: #fff; margin-bottom: 0.15rem;">
                      {exp.role}
                    </h4>
                    <div style="font-size: 0.8rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.4rem;">
                      {exp.organization}
                    </div>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 0.6rem;">
                      {exp.desc}
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                      {exp.skills.map((skill, sIdx) => (
                        <span key={sIdx} class="exp-skill-pill">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* Right Column: Verified Competition Honors & SK */}
      <div>
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <div style="width: 38px; height: 38px; border-radius: 50%; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); display: flex; align-items: center; justify-content: center; color: #fbbf24;">
              <Trophy size={18} />
            </div>
            <div>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: #fff;">Prestasi & Rekam Jejak Terverifikasi</h3>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Didukung dokumen SK resmi dan sertifikat nasional</span>
            </div>
          </div>

          <div class="honors-list">
            {honors.map((h, idx) => (
              <div key={idx} class="honor-item">
                <div class="honor-badge-icon">
                  <Award size={16} />
                </div>
                <div>
                  <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
                    <span class={getBadgeClass(h.badge)} style="max-width: 100%;">
                      {h.badge}
                    </span>
                    <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);">
                      {h.sk}
                    </span>
                  </div>
                  <h4 style="font-size: 0.92rem; font-weight: 700; color: #fff; margin-bottom: 0.25rem;">
                    {h.title}
                  </h4>
                  <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">
                    {h.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>

    {/* 4 Core Competency Pillars (Horizontal across full width, directly above Featured Engineering Systems) */}
    <div class="pillars-horizontal-section">
      <div class="pillars-horizontal-header">
        <div>
          <div class="kicker">Core Engineering Disciplines</div>
          <h3 class="pillars-section-title">
            4 Pilar Fondasi Rekayasa & Keahlian Teknis
          </h3>
        </div>
        <p class="pillars-section-subtitle">
          Arsitektur terintegrasi hulu-ke-hilir: dari sensor edge, visi komputer cerdas, geospasial analitik, hingga keandalan operasional.
        </p>
      </div>

      <div class="pillars-horizontal-grid">
        {pillars.map((p, idx) => {
          const Icon = p.icon;
          return (
            <div key={idx} class="glass-card pillar-horizontal-card">
              <div class="pillar-card-top">
                <div class="pillar-icon-box">
                  <Icon size={18} />
                </div>
                <h4 class="pillar-card-title">{p.title}</h4>
              </div>
              <p class="pillar-card-desc">
                {p.desc}
              </p>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>
