---
import { BookOpen, Trophy, Award, Briefcase, Calendar, Building2, MapPin, GraduationCap, FileText, Mail, ArrowUpRight } from 'lucide-react';
import { Github, Linkedin } from './BrandIcons';

const experiences = [
  {
    role: "AI & Full-Stack Developer Intern",
    organization: "PT Naraya Telematika",
    type: "Magang Industri",
    period: "Juli 2026 – Sekarang",
    desc: "Mengembangkan pipeline produksi animasi AI generatif berbasis integrasi workflow ComfyUI dan Dify, serta merancang dan mengimplementasikan platform website Ads Manager yang terintegrasi langsung dengan Meta Ads API dan Google Ads API.",
    skills: ["ComfyUI", "Dify", "Generative AI", "Meta Ads API", "Google Ads API", "Full-Stack Web"],
    icon: Building2
  },
  {
    role: "IT & WebGIS Production Developer",
    organization: "Badan Riset dan Inovasi Nasional (BRIN) × Polinema",
    type: "Magang Riset Terapan",
    period: "Mei – Juli 2026",
    desc: "Mengembangkan platform WebGIS produksi SIMOJANG Brantas untuk peringatan dini banjir DAS Brantas Hulu. Mengintegrasikan telemetri radar BMKG, data spasial BPBD, dan optimasi rendering GeoJSON.",
    skills: ["WebGIS", "Leaflet", "GeoJSON", "Spatial DB", "BMKG Radar"],
    icon: Building2
  },
  {
    role: "Cook & Operations",
    organization: "Sektor F&B Komersial (Hospitality & Culinary Operations)",
    type: "Operasional Komersial",
    period: "2025",
    desc: "Mengelola alur operasional dapur komersial berkecepatan tinggi, konsistensi mutu penyajian, manajemen bahan baku, serta penegakan standar kerja presisi dengan toleransi kesalahan nol.",
    skills: ["Operational Rigor", "High-Pace Execution", "Quality Control", "Inventory Flow"],
    icon: Briefcase
  }
];

const honors = [
  {
    badge: "Harapan 2 Nasional",
    title: "Techno Fair and Seminar (TFS) 2026 — CatfishCare",
    sk: "SK Direktur Polinema No. 27881/PL2.3/KM/2026",
    category: "Lomba Karya Tulis Ilmiah Nasional"
  },
  {
    badge: "Tahap 2 Lolos Insentif",
    title: "PKM-GFT POLINEMA 2026 — Smart Aquaculture Intelligence System (SAIS)",
    sk: "SK No. 40/WADIR.III/KM/2026",
    category: "Program Kreativitas Mahasiswa"
  },
  {
    badge: "Finalis",
    title: "Intelecta Cup 2025 — Agroclimatology Time-Series Weather Forecasting",
    category: "Kompetisi Sains Data Nasional"
  },
  {
    badge: "Finalis",
    title: "Techno Fair and Seminar (TFS) 2025 — AlgaSense",
    sk: "SK Direktur Polinema No. 16002/PL2.3/KM/2025",
    category: "LKTI Nasional"
  },
  {
    badge: "Peserta Terpilih",
    title: "Hology 8.0 (2025) Data Mining — Crowd Density Estimation",
    category: "Kompetisi Nasional Data Mining"
  },
  {
    badge: "Peserta Terpilih",
    title: "Jatim Datathon 2025 — SLB Spatial Disparity Analysis",
    category: "Kompetisi Analisis Data Jawa Timur"
  }
];

const getExpBadgeClass = (type: string) => {
  if (type.includes('Industri')) return 'exp-badge exp-badge-industry';
  if (type.includes('Riset')) return 'exp-badge exp-badge-research';
  return 'exp-badge exp-badge-commercial';
};
---

<section class="section-padding" id="about" aria-labelledby="about-title" data-chapter="about">
  <div class="container">
    
    {/* Section Head */}
    <div class="section-head" data-in style="margin-bottom: 3.5rem;">
      <div class="kicker">About Me // Engineering Background</div>
      <h2 class="section-title" id="about-title" style="letter-spacing: -0.035em;">
        About Me &amp; Applied Engineering
      </h2>
      <p class="section-subtitle">
        Kombinasi disiplin akademik D4 Teknik Informatika Polinema, riset terapan institusional, dan eksekusi sistem di lapangan.
      </p>
    </div>

    {/* About Layout Grid: Left Portrait Centerpiece (Sticky until Jatim Datathon) + Right Detailed Credentials */}
    <div class="dossier-layout-grid">
      
      {/* Left Column: Authentic Portrait Card (Sticky Desktop) */}
      <aside class="dossier-portrait-card">
        {/* Crosshair Coordinates */}
        <span class="hero-card-crosshair tl">+</span>
        <span class="hero-card-crosshair tr">+</span>
        <span class="hero-card-crosshair bl">+</span>
        <span class="hero-card-crosshair br">+</span>

        {/* Technical Header */}
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.65rem; border-bottom: 1px solid rgba(255, 255, 255, 0.12); gap: 0.5rem;">
          <span style="font-family: var(--font-mono); font-size: 0.66rem; color: var(--accent-action); font-weight: 700; letter-spacing: 0.06em; white-space: nowrap;">
            SYS // ABOUT · PROFILE
          </span>
          <span style="font-family: var(--font-mono); font-size: 0.65rem; color: #94a3b8; white-space: nowrap;">
            MALANG · 112.61° E, 7.94° S
          </span>
        </div>

        {/* High-Resolution Professional Portrait */}
        <div class="dossier-img-box">
          <img 
            src="/assets/image/saya.jpg?v=2" 
            alt="Foto profil resmi Varizky Naldiba Rimra"
            width="450"
            height="450"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        {/* Identity Details */}
        <div style="margin-top: 1.25rem;">
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 0.25rem;">
            Varizky Naldiba Rimra
          </h3>
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-action); font-weight: 700; display: block; margin-bottom: 0.75rem;">
            Applied ML &amp; Distributed Systems Engineer
          </span>

          <div style="display: flex; flex-direction: column; gap: 0.4rem; padding-top: 0.75rem; border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.82rem; color: #cbd5e1;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <GraduationCap size={15} color="var(--accent-action)" />
              <span>Politeknik Negeri Malang (Polinema)</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <MapPin size={15} color="var(--accent-action)" />
              <span>Malang, Jawa Timur, Indonesia</span>
            </div>
          </div>

          {/* Direct Channels */}
          <div style="display: flex; gap: 0.6rem; margin-top: 1.25rem; flex-wrap: wrap;">
            <a 
              href="/CV - Varizky Naldiba Rimra.pdf" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary btn-sm"
              style="background: var(--accent-action); color: #0b132b !important; border: 1px solid var(--accent-action); border-radius: var(--radius-lg); padding: 0.45rem 0.9rem; font-weight: 700;"
              aria-label="Unduh berkas Curriculum Vitae (PDF)"
              data-cursor="CV PDF"
            >
              <FileText size={14} />
              <span>CV (PDF)</span>
            </a>
            <a 
              href="https://github.com/VarizkyNaldiba" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-ghost btn-sm"
              style="padding: 0.45rem 0.7rem;"
              aria-label="Kunjungi profil GitHub Varizky Naldiba di tab baru"
              data-cursor="GITHUB"
            >
              <Github size={15} />
            </a>
            <a 
              href="https://www.linkedin.com/in/varizkynaldiba/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-ghost btn-sm"
              style="padding: 0.45rem 0.7rem;"
              aria-label="Kunjungi profil LinkedIn Varizky Naldiba di tab baru"
              data-cursor="LINKEDIN"
            >
              <Linkedin size={15} />
            </a>
            <a 
              href="mailto:varizkynr@gmail.com" 
              class="btn-ghost btn-sm"
              style="padding: 0.45rem 0.7rem;"
              aria-label="Kirim pesan email ke Varizky Naldiba"
              data-cursor="EMAIL"
            >
              <Mail size={15} />
            </a>
          </div>
        </div>
      </aside>

      {/* Right Column: Narrative, Experience, and Verified Honors */}
      <div class="dossier-content-col" data-in>
        
        {/* Engineering Philosophy Manifesto */}
        <div class="glass-card" style="margin-bottom: 2rem;">
          <h3 style="font-size: 1.35rem; font-weight: 800; color: #ffffff; margin-bottom: 1rem; letter-spacing: -0.02em;">
            Menjembatani Perangkat Keras Fisik, Data Spasial, dan Kecerdasan Buatan Terapan.
          </h3>
          <p style="color: #cbd5e1; line-height: 1.7; margin-bottom: 1rem; font-size: 0.94rem;">
            Saya merupakan mahasiswa <strong>D4 Teknik Informatika di Politeknik Negeri Malang (Polinema)</strong>. 
            Prinsip rekayasa saya berakar pada <em>Project-Based Engineering</em> dan pemecahan masalah konkret: 
            mengkalibrasi sensor kimia air untuk pembudidaya lele dan rumput laut, memetakan risiko banjir 
            DAS Brantas bersama BRIN, hingga membangun sistem pipeline animasi AI generatif terdistribusi.
          </p>
          <p style="color: #cbd5e1; line-height: 1.7; font-size: 0.94rem;">
            Latar belakang disiplin operasional sebelum mendalami informatika membentuk etos kerja saya: 
            selalu siap menangani kondisi kritis, menghargai toleransi kesalahan nol, dan memastikan setiap baris kode 
            berfungsi optimal di lingkungan produksi.
          </p>

          {/* Education Callout */}
          <div class="education-callout" style="margin-top: 1.5rem;">
            <div class="edu-icon-wrap" style="background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.28); color: var(--accent-action);">
              <BookOpen size={20} />
            </div>
            <div>
              <span style="display: block; font-size: 0.95rem; font-weight: 700; color: #ffffff;">
                D4 Teknik Informatika (Informatics Engineering)
              </span>
              <span style="display: block; font-size: 0.82rem; color: var(--accent-action); font-weight: 600; margin-top: 0.2rem;">
                Politeknik Negeri Malang (Polinema) · 2022 – Sekarang
              </span>
              <span style="display: block; font-size: 0.8rem; color: #cbd5e1; margin-top: 0.35rem;">
                Fokus Rekayasa: Applied Machine Learning, IoT Embedded Firmware, Geospatial Analytics &amp; WebGIS
              </span>
            </div>
          </div>
        </div>

        {/* Work & Applied Experience */}
        <div class="glass-card" style="margin-bottom: 2rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: rgba(212, 255, 0, 0.12); border: 1px solid rgba(212, 255, 0, 0.3); display: flex; align-items: center; justify-content: center; color: var(--accent-action);">
              <Briefcase size={16} />
            </div>
            <div>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: #ffffff;">Pengalaman Rekayasa Terapan</h3>
              <span style="font-size: 0.75rem; color: #94a3b8;">Industrial Internship, Institutional Research &amp; Commercial Systems</span>
            </div>
          </div>

          <div class="experience-list">
            {experiences.map((exp, idx) => {
              const ExpIcon = exp.icon;
              return (
                <div key={idx} class="experience-item">
                  <div class="exp-icon-wrap">
                    <ExpIcon size={15} />
                  </div>
                  <div style="flex: 1; min-width: 0;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
                      <span class={getExpBadgeClass(exp.type)}>
                        {exp.type}
                      </span>
                      <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-action); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
                        <Calendar size={12} />
                        {exp.period}
                      </span>
                    </div>
                    <h4 style="font-size: 0.92rem; font-weight: 700; color: #ffffff; margin-bottom: 0.15rem;">
                      {exp.role}
                    </h4>
                    <div style="font-size: 0.8rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.4rem;">
                      {exp.organization}
                    </div>
                    <p style="font-size: 0.82rem; color: #cbd5e1; line-height: 1.55; margin-bottom: 0.6rem;">
                      {exp.desc}
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.65rem;">
                      {exp.skills.map((skill, sIdx) => (
                        <span key={sIdx} class="exp-skill-pill">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Verified Honors & Awards */}
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: rgba(212, 255, 0, 0.12); border: 1px solid rgba(212, 255, 0, 0.3); display: flex; align-items: center; justify-content: center; color: var(--accent-action);">
              <Trophy size={16} />
            </div>
            <div>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: #ffffff;">Prestasi &amp; Rekognisi Kompetisi</h3>
              <span style="font-size: 0.75rem; color: #94a3b8;">Verified National Honors &amp; Research Awards</span>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {honors.map((h, idx) => (
              <div key={idx} style="padding: 1rem; border-radius: var(--radius-md); background: rgba(5, 10, 22, 0.45); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem; flex-wrap: wrap; gap: 0.5rem;">
                  <span style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--accent-action); background: rgba(212, 255, 0, 0.1); padding: 0.2rem 0.55rem; border-radius: 4px; border: 1px solid rgba(212, 255, 0, 0.25);">
                    {h.badge}
                  </span>
                  <span style="font-size: 0.72rem; color: #94a3b8;">
                    {h.category}
                  </span>
                </div>
                <div style="font-size: 0.88rem; font-weight: 700; color: #ffffff; margin-bottom: 0.2rem;">
                  {h.title}
                </div>
                {h.sk && (
                  <div style="font-family: var(--font-mono); font-size: 0.72rem; color: #94a3b8;">
                    {h.sk}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  @media (min-width: 992px) {
    .dossier-layout-grid {
      display: grid !important;
      grid-template-columns: 360px 1fr !important;
      gap: 3.5rem !important;
      align-items: start !important;
    }

    .dossier-portrait-card {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 5.5rem !important;
      align-self: start !important;
      z-index: 25 !important;
    }
  }
</style>
