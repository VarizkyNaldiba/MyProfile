---
import { ArrowUpRight, Video, Play, Film, Share2 } from 'lucide-react';
import { TikTok, Bilibili } from './BrandIcons';

const channels = [
  {
    platform: 'TikTok',
    handle: '@oryzasatirva',
    title: 'Short-Form Motion Production & Visual Storytelling',
    desc: 'Producing educational video content on game mechanics and dynamic motion graphics, optimizing pacing rhythm and short-form viewer retention.',
    url: 'https://www.tiktok.com/@oryzasatirva',
    icon: TikTok,
    tags: ['Motion Graphics', 'Short-Form Video', 'Audience Retention']
  },
  {
    platform: 'Bilibili',
    handle: 'Space 1416802109',
    title: 'Long-Form Video Documentation & Mechanics Breakdown',
    desc: 'Publishing high-resolution documentary archives, tactical mechanics breakdowns, and comprehensive guides for the technical community.',
    url: 'https://www.bilibili.tv/id/space/1416802109',
    icon: Bilibili,
    tags: ['Long-Form Archive', 'Game Mechanics', 'Community Guides']
  }
];
---

<section class="section-padding" id="creative" aria-labelledby="creative-title" data-chapter="creative">
  <div class="container" data-in>
    
    <div class="section-head center">
      <div class="kicker">Digital Media & Visual Engineering</div>
      <h2 class="section-title" id="creative-title">Media Production & Distribution</h2>
      <p class="section-subtitle">
        Application of motion visual engineering, structured narrative design, and audience retention analytics across digital video channels.
      </p>
    </div>

    <div class="creative-grid">
      {channels.map((ch, idx) => {
        const Icon = ch.icon;
        return (
          <div key={idx} class="creative-portal-card">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
              <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.25); display: flex; align-items: center; justify-content: center; color: #ffffff;">
                  <Icon size={22} />
                </div>
                <div>
                  <span style="display: block; font-size: 1rem; font-weight: 700; color: #ffffff;">{ch.platform}</span>
                  <span style="display: block; font-size: 0.8rem; color: var(--accent-action); font-family: var(--font-mono); font-weight: 600;">{ch.handle}</span>
                </div>
              </div>
              <a 
                href={ch.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-channel-icon"
                title={`Visit ${ch.platform}`}
                aria-label={`Visit ${ch.platform} channel (${ch.handle}) in a new tab`}
              >
                <ArrowUpRight size={16} aria-hidden="true" />
              </a>
            </div>

            <h3 style="font-size: 1.15rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem; line-height: 1.35;">
              {ch.title}
            </h3>
            <p style="font-size: 0.86rem; color: #cbd5e1; line-height: 1.6; margin-bottom: 1.5rem;">
              {ch.desc}
            </p>

            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; margin-bottom: 1.5rem;">
              {ch.tags.map((t, tIdx) => (
                <span key={tIdx} class="skill-tag">
                  {t}
                </span>
              ))}
            </div>

            <a 
              href={ch.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary"
              style="width: 100%; text-decoration: none;"
              aria-label={`Open ${ch.platform} channel (${ch.handle}) in a new tab`}
            >
              <span>Open {ch.platform} Channel</span>
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </div>
        );
      })}
    </div>

  </div>
</section>
