---
import { Activity, ShieldCheck, Zap, GitBranch, Cpu, Database, Server } from 'lucide-react';

const pipelineSteps = [
  {
    step: "01",
    title: "Sensing & Hardware Calibration",
    icon: Cpu,
    desc: "Akuisisi sinyal analog dari sensor bawah air, kompensasi temperatur suhu seketika, dan pembuatan kurva kalibrasi polinomial untuk probe pH/kekeruhan."
  },
  {
    step: "02",
    title: "Data Preprocessing & Deep Learning",
    icon: Database,
    desc: "Ekstraksi fitur multi-skala (MCNN, GLCM, Wavelet), pembersihan derau deret waktu, dan pelatihan jaringan syaraf tiruan rekuren (LSTM) untuk peramalan panen."
  },
  {
    step: "03",
    title: "Cloud Sync, WebGIS & Decision Support",
    icon: Server,
    desc: "Integrasi failover ring buffer pada memori flash ESP32, sinkronisasi datastore noSQL, perenderan layer spasial GeoJSON, dan algoritma PROMETHEE DSS."
  }
];

const metrics = [
  { val: "13", label: "Engineered Systems", sub: "ML, IoT, WebGIS & Enterprise" },
  { val: "94.310", label: "Kaggle Score", sub: "Peringkat 18/82 Intelecta Cup" },
  { val: "Harapan 2", label: "Juara Nasional LKTI", sub: "TFS 2026 (SK Direktur Polinema)" },
  { val: "0%", label: "Failover Data Loss", sub: "ESP32 Circular Flash Buffer" }
];
---

<section class="section-padding" id="methodology">
  <div class="container">
    
    <div class="section-head center">
      <div class="kicker">Engineering Workflow & Impact</div>
      <h2 class="section-title">Alur Rekayasa Sistem & Dampak Terukur</h2>
      <p class="section-subtitle">
        Pola metodologi hulu-ke-hilir yang diterapkan untuk menjamin keandalan instrumen di lapangan dan akurasi model prediktif.
      </p>
    </div>

    {/* 3 Pipeline Steps */}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3.5rem;">
      {pipelineSteps.map((step, idx) => {
        const Icon = step.icon;
        return (
          <div key={idx} class="glass-card" style="position: relative; overflow: hidden;">
            <span style="position: absolute; top: 1rem; right: 1.25rem; font-family: var(--font-mono); font-size: 2.25rem; font-weight: 800; color: rgba(255, 255, 255, 0.05); pointer-events: none;">
              {step.step}
            </span>
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.25); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan); margin-bottom: 1.25rem;">
              <Icon size={18} />
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">
              {step.title}
            </h3>
            <p style="font-size: 0.86rem; color: var(--text-secondary); line-height: 1.6;">
              {step.desc}
            </p>
          </div>
        );
      })}
    </div>

    {/* Impact Metrics Strip */}
    <div class="metrics-strip">
      {metrics.map((m, idx) => (
        <div key={idx} class="metric-box">
          <div class="metric-val">{m.val}</div>
          <div class="metric-label">{m.label}</div>
          <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem;">{m.sub}</div>
        </div>
      ))}
    </div>

  </div>
</section>
