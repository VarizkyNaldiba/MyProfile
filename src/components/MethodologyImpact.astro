---
import { Cpu, Database, Server } from 'lucide-react';

const pipelineSteps = [
  {
    stage: "Edge Hardware",
    title: "Sensing & Hardware Calibration",
    icon: Cpu,
    desc: "Analog signal acquisition from subsea probes, real-time temperature compensation, and polynomial calibration curve derivation for pH and turbidity sensors."
  },
  {
    stage: "Intelligence",
    title: "Data Preprocessing & Deep Learning",
    icon: Database,
    desc: "Multi-scale spatial feature extraction (MCNN, GLCM, Wavelet), time-series noise filtering, and recurrent neural network (LSTM) training for yield forecasting."
  },
  {
    stage: "Infrastructure",
    title: "Cloud Sync, WebGIS & Decision Support",
    icon: Server,
    desc: "ESP32 circular ring buffer failover to local flash, real-time cloud datastore synchronization, performant GeoJSON rendering, and PROMETHEE DSS algorithms."
  }
];

const metrics = [
  { val: "Production", label: "Engineered Systems", sub: "ML, IoT, WebGIS & Enterprise" },
  { val: "5th Place", label: "National LKTI Honor", sub: "TFS 2026 (Director SK Polinema)" },
  { val: "Recognized", label: "National Awards", sub: "National Competitions & BRIN Research" },
  { val: "Phase 2", label: "Research Grant", sub: "PKM-GFT Polinema 2026" }
];
---

<section class="section-padding" id="methodology" aria-labelledby="methodology-title" data-chapter="methodology">
  <div class="container" data-in>
    
    <div class="section-head center">
      <div class="kicker">Engineering Workflow &amp; Impact</div>
      <h2 class="section-title" id="methodology-title" style="letter-spacing: -0.035em;">
        From concept to hardware that works in the field.
      </h2>
      <p class="section-subtitle">
        An end-to-end engineering methodology ensuring field hardware reliability and machine learning predictive precision.
      </p>
    </div>

    {/* Pipeline Steps (Puture Process Style - No Numbers) */}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem; margin-bottom: 3.5rem;">
      {pipelineSteps.map((step, idx) => {
        const Icon = step.icon;
        return (
          <div key={idx} class="feature-card" style="padding: 1.5rem; justify-content: flex-start;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
              <span style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--accent-action); background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.25); padding: 0.2rem 0.6rem; border-radius: 4px; letter-spacing: 0.05em; text-transform: uppercase;">
                STAGE // {step.stage}
              </span>
              <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(14, 165, 233, 0.12); border: 1px solid rgba(14, 165, 233, 0.35); display: flex; align-items: center; justify-content: center; color: #ffffff;" aria-hidden="true">
                <Icon size={18} />
              </div>
            </div>

            <h3 style="font-size: 1.15rem; font-weight: 800; color: #ffffff; margin-bottom: 0.65rem; line-height: 1.35; letter-spacing: -0.02em;">
              {step.title}
            </h3>
            <p style="font-size: 0.86rem; color: #cbd5e1; line-height: 1.65;">
              {step.desc}
            </p>
          </div>
        );
      })}
    </div>

    {/* Impact Metrics Strip */}
    <div class="metrics-strip">
      {metrics.map((m, idx) => (
        <div key={idx} class="metric-box">
          <div class="metric-val">{m.val}</div>
          <div class="metric-label">{m.label}</div>
          <div style="font-size: 0.72rem; color: #cbd5e1; margin-top: 0.2rem;">{m.sub}</div>
        </div>
      ))}
    </div>

  </div>
</section>
