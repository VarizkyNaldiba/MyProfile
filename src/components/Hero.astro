---
import { ArrowRight, Mail } from 'lucide-react';
---

<section class="hero-section puture-hero" id="home" aria-labelledby="hero-title" data-chapter="about">
  <div class="container puture-hero-container">

    {/* Puture Massive Spatial Title with Letter Emerge Animation */}
    <div class="puture-hero-center">
      <div style="font-family: var(--font-mono); font-size: clamp(0.85rem, 1.2vw, 1.05rem); color: var(--text-main); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 0.75rem; text-transform: uppercase;">
        Applied Machine Learning &amp; Distributed Systems Engineer
      </div>
      <h1 class="puture-massive-title" id="hero-title">
        <div class="emerge-line">
          <span class="shell__word"><span class="shell__char" style="animation-delay: 0.08s;">Systems,</span></span>
        </div>
        <div class="emerge-line">
          <span class="shell__word"><span class="shell__char highlight-blue" style="animation-delay: 0.22s;">engineered.</span></span>
        </div>
      </h1>
    </div>

    {/* Bottom Narrative & Single Primary CTA Action */}
    <div class="puture-hero-bottom">
      <div class="puture-hero-lede-col">
        <p class="puture-hero-lede">
          Informatics Engineer (Politeknik Negeri Malang). Merancang pipa rekayasa hulu-ke-hilir: 
          telemetri sensor mikrokontroler edge (ESP32), pemodelan deep learning terapan (Computer Vision &amp; LSTM), 
          hingga arsitektur platform web spasial produksi.
        </p>
      </div>

      <div class="puture-hero-actions-col">
        <div class="hero-actions" style="display: flex; flex-wrap: wrap; gap: 0.85rem; align-items: center;">
          {/* One Single Main Primary Button per Unslop Rule #10 */}
          <a href="#projects" class="btn--puture-primary" data-cursor="PROJECTS">
            <span>Explore Projects</span>
            <ArrowRight size={16} aria-hidden="true" />
          </a>

          {/* Secondary Actions: Clean Ghost / Outline Links */}
          <a href="#about" class="btn btn-ghost" data-cursor="ABOUT" style="border-radius: var(--radius-lg); border: 1px solid rgba(11, 19, 43, 0.25); color: var(--text-main); background: transparent;">
            <span>About</span>
          </a>

          <a href="#contact" class="btn btn-ghost" data-cursor="CONTACT" style="border-radius: var(--radius-lg); border: 1px solid rgba(11, 19, 43, 0.25); color: var(--text-main); background: transparent;">
            <Mail size={15} aria-hidden="true" />
            <span>Contact</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
