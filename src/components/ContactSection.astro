---
import { Mail, FileText, ArrowUpRight, Copy, ExternalLink, MapPin, Clock, CheckCircle2, Sparkles } from 'lucide-react';
import { Github, Linkedin, Instagram, TikTok, Facebook } from './BrandIcons';

const emailAddress = "varizkynr@gmail.com";

const socialLinks = [
  {
    name: "GitHub",
    handle: "@VarizkyNaldiba",
    desc: "Engineering repositories, AI models, and IoT firmware source code.",
    url: "https://github.com/VarizkyNaldiba",
    icon: Github
  },
  {
    name: "LinkedIn",
    handle: "varizkynaldiba",
    desc: "Professional track record, academic network, and industry relations.",
    url: "https://www.linkedin.com/in/varizkynaldiba/",
    icon: Linkedin
  },
  {
    name: "Instagram",
    handle: "@v.naldiba",
    desc: "Campus research activities, competition projects, and academic life.",
    url: "https://www.instagram.com/v.naldiba/",
    icon: Instagram
  },
  {
    name: "TikTok",
    handle: "@oryzasatirva",
    desc: "Short-form motion graphics portfolio and gameplay mechanics.",
    url: "https://www.tiktok.com/@oryzasatirva",
    icon: TikTok
  },
  {
    name: "Facebook",
    handle: "varizkynaldiba.rimra",
    desc: "Alumni network and regional communication.",
    url: "https://www.facebook.com/varizkynaldiba.rimra",
    icon: Facebook
  }
];
---

<section class="section-padding" id="contact" aria-labelledby="contact-heading" data-chapter="contact">
  <div class="container" data-in>
    
    <div class="section-head center">
      <div class="kicker">Official Communication</div>
      <h2 class="section-title" id="contact-heading" style="letter-spacing: -0.035em;">
        Your next engineering milestone, with Varizky.
      </h2>
      <p class="section-subtitle">
        From applied artificial intelligence to edge microcontroller telemetry. Open to software engineering roles, research collaborations, and production system deployments.
      </p>
    </div>

    <div class="contact-layout">
      
      {/* Left: Email Hub & Download Buttons */}
      <div class="contact-direct-card">
        
        {/* Direct Email Header */}
        <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 2rem;">
          <div style="width: 48px; height: 48px; border-radius: var(--radius-lg); background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.28); display: flex; align-items: center; justify-content: center; color: var(--accent-action); flex-shrink: 0;">
            <Mail size={22} />
          </div>
          <div>
            <span style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; font-weight: 700; display: block; margin-bottom: 0.2rem;">
              Primary Direct Email
            </span>
            <a href={`mailto:${emailAddress}`} style="font-size: 1.35rem; font-weight: 800; color: #ffffff; text-decoration: none; word-break: break-all;">
              {emailAddress}
            </a>
          </div>
        </div>

        {/* Action Buttons for Email */}
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
          <a href={`mailto:${emailAddress}`} class="btn btn-primary btn-sm" aria-label="Send direct email to Varizky">
            <span>Send Direct Email</span>
            <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          <button 
            type="button" 
            class="btn btn-glass btn-sm"
            onclick={`navigator.clipboard.writeText('${emailAddress}'); alert('Email address ${emailAddress} copied to clipboard!');`}
            aria-label="Copy email address to clipboard"
          >
            <Copy size={14} aria-hidden="true" />
            <span>Copy Address</span>
          </button>
        </div>

        {/* Official Document Download Cards */}
        <div style="padding-top: 1.75rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--accent-action); text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-bottom: 1rem;">
            Official Dossier Documents
          </span>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
            {/* CV Download Card */}
            <div style="background: rgba(5, 10, 22, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-md); padding: 1.25rem;">
              <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.5rem;">
                <FileText size={18} color="var(--accent-action)" aria-hidden="true" />
                <h3 style="font-size: 0.92rem; font-weight: 700; color: #ffffff;">Curriculum Vitae</h3>
              </div>
              <p style="font-size: 0.78rem; color: #cbd5e1; margin-bottom: 1rem; line-height: 1.5;">
                Comprehensive 2-page monochrome A4 dossier detailing all 13 engineering systems &amp; honors.
              </p>
              <a 
                href="/CV - Varizky Naldiba Rimra.pdf" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-primary btn-sm"
                style="width: 100%; text-decoration: none;"
                aria-label="Download Curriculum Vitae (PDF)"
              >
                <span>Download CV (PDF)</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>

      </div>

      {/* Right: Availability & Engineering Readiness Card */}
      <div class="glass-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 2rem;">
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.3); padding: 0.35rem 0.85rem; border-radius: var(--radius-md);">
              <span class="pulse-dot" style="background: var(--accent-action);"></span>
              <span style="font-size: 0.76rem; font-weight: 700; color: var(--accent-action); text-transform: uppercase; letter-spacing: 0.05em;">
                Available for Engineering Roles
              </span>
            </div>
            <Sparkles size={18} color="var(--accent-action)" />
          </div>

          <h3 style="font-size: 1.3rem; font-weight: 800; color: #ffffff; margin-bottom: 0.75rem; line-height: 1.35;">
            Ready to Engineer Resilient Production Systems
          </h3>
          <p style="font-size: 0.84rem; color: #cbd5e1; line-height: 1.6; margin-bottom: 1.75rem;">
            Available for full-time software engineering roles, industrial internships, and high-impact applied ML &amp; edge-to-cloud telemetry systems.
          </p>

          <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 1.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.25); display: flex; align-items: center; justify-content: center; color: var(--accent-action);">
                <Clock size={16} />
              </div>
              <div>
                <span style="display: block; font-size: 0.82rem; font-weight: 700; color: #ffffff;">Rapid Response</span>
                <span style="display: block; font-size: 0.75rem; color: #94a3b8;">&lt; 24 hours via official email</span>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.25); display: flex; align-items: center; justify-content: center; color: var(--accent-action);">
                <MapPin size={16} />
              </div>
              <div>
                <span style="display: block; font-size: 0.82rem; font-weight: 700; color: #ffffff;">Location &amp; Mobility</span>
                <span style="display: block; font-size: 0.75rem; color: #94a3b8;">Malang, East Java, Indonesia (Onsite / Hybrid / Remote)</span>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.25); display: flex; align-items: center; justify-content: center; color: var(--accent-action);">
                <CheckCircle2 size={16} />
              </div>
              <div>
                <span style="display: block; font-size: 0.82rem; font-weight: 700; color: #ffffff;">Core Technical Focus</span>
                <span style="display: block; font-size: 0.75rem; color: #94a3b8;">Applied ML, Edge IoT Probes &amp; WebGIS Systems</span>
              </div>
            </div>
          </div>
        </div>

        <div style="padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.1); display: flex; gap: 0.75rem;">
          <a href="https://www.linkedin.com/in/varizkynaldiba/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="flex: 1; text-align: center;" aria-label="Visit Varizky Naldiba's LinkedIn profile in a new tab">
            <span>LinkedIn Connection</span>
            <ArrowUpRight size={13} aria-hidden="true" />
          </a>
          <a href="https://github.com/VarizkyNaldiba" target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-sm" style="flex: 1; text-align: center;" aria-label="Visit Varizky Naldiba's GitHub profile in a new tab">
            <span>GitHub Profile</span>
            <ExternalLink size={13} aria-hidden="true" />
          </a>
        </div>
      </div>

    </div>

    {/* Social Portal Cards Grid */}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem;">
      {socialLinks.map((item, idx) => {
        const Icon = item.icon;
        return (
          <a 
            key={idx}
            href={item.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="glass-card" 
            style="padding: 1.25rem; text-decoration: none; display: flex; align-items: flex-start; gap: 0.85rem; transition: transform 0.2s ease;"
            aria-label={`Visit ${item.name} profile (${item.handle}) in a new tab`}
          >
            <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.25); display: flex; align-items: center; justify-content: center; color: var(--accent-action); flex-shrink: 0;" aria-hidden="true">
              <Icon size={16} />
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="font-size: 0.88rem; font-weight: 700; color: #ffffff;">{item.name}</span>
                <ArrowUpRight size={12} color="var(--accent-action)" aria-hidden="true" />
              </div>
              <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--accent-action); font-weight: 600; display: block; margin-top: 0.1rem;">
                {item.handle}
              </span>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</section>
