---
// ThreeSpaceCanvas.astro — Outer Space (Antariksa) 3D Starfield & Nebula Animation
---

<div class="three-space-container" id="three-space-container" aria-hidden="true">
  <canvas id="three-space-canvas"></canvas>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('three-space-canvas') as HTMLCanvasElement;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReducedMotion) {
    // 1. Scene & Camera Setup (Deep Cosmic View)
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x000000, 0.0018);

    const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1200);
    camera.position.set(0, 0, 15);

    // 2. High-Performance WebGL Renderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    // 3. Multi-Tier 3D Cosmic Starfield (Deep Antariksa)
    const starCount = 3200;
    const starPositions = new Float32Array(starCount * 3);
    const starColors = new Float32Array(starCount * 3);

    // Palette: Stellar Cyan, Cobalt Blue, Pure Diamond White, Warm Gold, Soft Violet
    const palette = [
      new THREE.Color(0x38bdf8), // Ice Cyan
      new THREE.Color(0x3b82f6), // Cobalt Blue
      new THREE.Color(0xffffff), // Pure White
      new THREE.Color(0x93c5fd), // Sky Blue
      new THREE.Color(0xc084fc), // Soft Nebula Violet
      new THREE.Color(0xfef08a)  // Solar Gold
    ];

    for (let i = 0; i < starCount; i++) {
      const i3 = i * 3;
      // Spread stars widely across 3D cylindrical volume
      starPositions[i3] = (Math.random() - 0.5) * 220;
      starPositions[i3 + 1] = (Math.random() - 0.5) * 160;
      starPositions[i3 + 2] = (Math.random() - 0.5) * 450 - 50;

      const color = palette[Math.floor(Math.random() * palette.length)];
      starColors[i3] = color.r;
      starColors[i3 + 1] = color.g;
      starColors[i3 + 2] = color.b;
    }

    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeo.setAttribute('color', new THREE.BufferAttribute(starColors, 3));

    // Custom circular soft glow texture for stars
    const createStarTexture = () => {
      const c = document.createElement('canvas');
      c.width = 32;
      c.height = 32;
      const ctx = c.getContext('2d');
      if (ctx) {
        const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
        gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
        gradient.addColorStop(0.35, 'rgba(147, 197, 253, 0.85)');
        gradient.addColorStop(0.8, 'rgba(59, 130, 246, 0.25)');
        gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 32, 32);
      }
      return new THREE.CanvasTexture(c);
    };

    const starTexture = createStarTexture();

    const starMat = new THREE.PointsMaterial({
      size: 1.85,
      map: starTexture,
      transparent: true,
      vertexColors: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    const starField = new THREE.Points(starGeo, starMat);
    scene.add(starField);

    // 4. Distant Swirling Nebula Clouds (Cosmic Gas)
    const nebulaGroup = new THREE.Group();
    const nebulaCount = 6;
    const nebulaColors = [0x1d4ed8, 0x0284c7, 0x7c3aed, 0x2563eb];

    for (let n = 0; n < nebulaCount; n++) {
      const nebulaGeo = new THREE.SphereGeometry(14 + Math.random() * 10, 16, 16);
      const nebulaMat = new THREE.MeshBasicMaterial({
        color: nebulaColors[n % nebulaColors.length],
        transparent: true,
        opacity: 0.05 + Math.random() * 0.04,
        wireframe: true,
        blending: THREE.AdditiveBlending
      });
      const nebulaMesh = new THREE.Mesh(nebulaGeo, nebulaMat);
      nebulaMesh.position.set(
        (Math.random() - 0.5) * 120,
        (Math.random() - 0.5) * 80,
        -100 - Math.random() * 180
      );
      nebulaMesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
      nebulaGroup.add(nebulaMesh);
    }
    scene.add(nebulaGroup);

    // 5. Scroll Interaction & Dynamic Space Warp Flight Physics
    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;
    let targetCameraZ = 15;
    let mouseX = 0;
    let mouseY = 0;
    let curMouseX = 0;
    let curMouseY = 0;

    const onScroll = () => {
      const currentScroll = window.scrollY;
      const delta = currentScroll - lastScrollY;
      lastScrollY = currentScroll;

      // Add scroll velocity impulse to warp travel
      scrollVelocity += Math.abs(delta) * 0.08;

      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const progress = currentScroll / maxScroll;
      // Camera travels through deep space coordinates as user scrolls
      targetCameraZ = 15 - progress * 90;
    };

    const onPointerMove = (e: PointerEvent) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    // 6. Responsive Viewport Resize
    const onResize = () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
    };
    window.addEventListener('resize', onResize, { passive: true });

    // 7. 60fps Deep Space Journey Loop
    const posAttr = starGeo.attributes.position as THREE.BufferAttribute;
    const posArr = posAttr.array as Float32Array;

    let time = 0;
    const animate = () => {
      requestAnimationFrame(animate);

      time += 0.005;

      // Damp scroll impulse smoothly
      scrollVelocity *= 0.92;
      const effectiveSpeed = 0.25 + scrollVelocity * 1.8;

      // Smooth camera interpolation
      camera.position.z += (targetCameraZ - camera.position.z) * 0.06;

      // Smooth mouse parallax rotation (looking out into outer space)
      curMouseX += (mouseX - curMouseX) * 0.05;
      curMouseY += (mouseY - curMouseY) * 0.05;

      camera.rotation.y = -curMouseX * 0.12;
      camera.rotation.x = -curMouseY * 0.08;

      // Infinite flight: Stars stream towards and past the camera!
      for (let i = 0; i < starCount; i++) {
        const i3 = i * 3;
        // Move stars forward along Z
        posArr[i3 + 2] += effectiveSpeed;

        // If a star flies behind the camera, respawn it far into deep space
        if (posArr[i3 + 2] > camera.position.z + 15) {
          posArr[i3 + 2] = camera.position.z - 380;
          posArr[i3] = (Math.random() - 0.5) * 220;
          posArr[i3 + 1] = (Math.random() - 0.5) * 160;
        }
      }
      posAttr.needsUpdate = true;

      // Slowly rotate nebula clouds
      nebulaGroup.rotation.y = time * 0.04;
      nebulaGroup.rotation.z = time * 0.02;

      renderer.render(scene, camera);
    };

    requestAnimationFrame(animate);
  }
</script>
