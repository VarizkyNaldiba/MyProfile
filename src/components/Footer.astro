---
import { ArrowUp } from 'lucide-react';
---

<footer class="site-footer" role="contentinfo" aria-label="Site Footer">
  <div class="container">
    <div class="footer-inner">
      <div>
        <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
          <span style="font-size: 1.15rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em;">
            Varizky Naldiba Rimra
          </span>
          <span style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--accent-action); font-weight: 700; padding: 0.15rem 0.45rem; background: rgba(212, 255, 0, 0.1); border: 1px solid rgba(212, 255, 0, 0.25); border-radius: 4px;">
            D4 TI POLINEMA
          </span>
        </div>
        <p style="font-size: 0.84rem; color: #cbd5e1; max-width: 550px; line-height: 1.5; margin-bottom: 0.6rem;">
          Informatics Engineering — Politeknik Negeri Malang (Polinema). Applied Machine Learning, IoT Telemetry &amp; WebGIS.
        </p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.75rem;">
          <a href="#about" style="color: #e2f1fc; text-decoration: none;">About</a>
          <span style="color: rgba(255, 255, 255, 0.25);">·</span>
          <a href="#skills" style="color: #e2f1fc; text-decoration: none;">Capabilities</a>
          <span style="color: rgba(255, 255, 255, 0.25);">·</span>
          <a href="#projects" style="color: #e2f1fc; text-decoration: none;">Projects</a>
          <span style="color: rgba(255, 255, 255, 0.25);">·</span>
          <a href="#methodology" style="color: #e2f1fc; text-decoration: none;">Process</a>
          <span style="color: rgba(255, 255, 255, 0.25);">·</span>
          <a href="#creative" style="color: #e2f1fc; text-decoration: none;">Media</a>
          <span style="color: rgba(255, 255, 255, 0.25);">·</span>
          <a href="#contact" style="color: #e2f1fc; text-decoration: none;">Contact</a>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.85rem;">
        <a 
          href="#home"
          class="btn btn-glass btn-sm"
          aria-label="Back to top of page"
        >
          <span>Back to Top</span>
          <ArrowUp size={14} aria-hidden="true" />
        </a>

        <span style="font-size: 0.78rem; color: #94a3b8; font-family: var(--font-mono);">
          &copy; {new Date().getFullYear()} Varizky Naldiba Rimra. All rights reserved.
        </span>
      </div>
    </div>
  </div>
</footer>
