---
import { ArrowUp } from 'lucide-react';
---

<footer class="site-footer" role="contentinfo" aria-label="Informasi Penutup Situs">
  <div class="container">
    <div class="footer-inner">
      <div>
        <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
          <span style="font-size: 1.15rem; font-weight: 800; color: #fff; letter-spacing: -0.02em;">
            Varizky Naldiba Rimra
          </span>
          <span style="font-family: var(--font-mono); font-size: 0.68rem; color: #92c3ff; padding: 0.15rem 0.45rem; background: rgba(61, 139, 255, 0.12); border: 1px solid rgba(61, 139, 255, 0.3); border-radius: 4px;">
            D4 TI POLINEMA
          </span>
        </div>
        <p style="font-size: 0.84rem; color: var(--text-muted); max-width: 550px; line-height: 1.5; margin-bottom: 0.6rem;">
          D4 Teknik Informatika — Politeknik Negeri Malang (Polinema). Rekayasa Machine Learning Terapan, Telemetri IoT &amp; WebGIS.
        </p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.75rem;">
          <a href="#about" style="color: var(--text-secondary); text-decoration: none;">About</a>
          <span style="color: rgba(255, 255, 255, 0.2);">·</span>
          <a href="#skills" style="color: var(--text-secondary); text-decoration: none;">Capabilities</a>
          <span style="color: rgba(255, 255, 255, 0.2);">·</span>
          <a href="#projects" style="color: var(--text-secondary); text-decoration: none;">Projects</a>
          <span style="color: rgba(255, 255, 255, 0.2);">·</span>
          <a href="#methodology" style="color: var(--text-secondary); text-decoration: none;">Process</a>
          <span style="color: rgba(255, 255, 255, 0.2);">·</span>
          <a href="#creative" style="color: var(--text-secondary); text-decoration: none;">Media</a>
          <span style="color: rgba(255, 255, 255, 0.2);">·</span>
          <a href="#contact" style="color: var(--text-secondary); text-decoration: none;">Contact</a>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.85rem;">
        <a 
          href="#home"
          class="btn btn-glass btn-sm"
          aria-label="Kembali ke bagian paling atas halaman"
        >
          <span>Ke Atas</span>
          <ArrowUp size={14} aria-hidden="true" />
        </a>

        <span style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">
          &copy; {new Date().getFullYear()} Varizky Naldiba Rimra. All rights reserved.
        </span>
      </div>
    </div>
  </div>
</footer>
