---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutEducation from '../components/AboutEducation.astro';
import TomDeKoningCarousel from '../components/TomDeKoningCarousel.jsx';
import PutureSkillsStack from '../components/PutureSkillsStack.astro';
import MethodologyImpact from '../components/MethodologyImpact.astro';
import CreativeMedia from '../components/CreativeMedia.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <AboutEducation />
    {/* 13 Projects Interactive Carousel */}
    <TomDeKoningCarousel client:load />
    {/* Puture Vertical Stacking Cards for Core Tech Capabilities */}
    <PutureSkillsStack />
    <MethodologyImpact />
    <CreativeMedia />
    <ContactSection />
  </main>
  <Footer />
</Layout>
